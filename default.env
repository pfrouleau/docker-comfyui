# NOTE: This file provides default values for environment variables used in the Makefile and Dockerfile.
# You should not edit this file. Instead, create a .env file in the project root to override these values.
# This file is committed to the repository to provide sensible defaults, while .env is ignored by git to
# allow for local customization.

# Docker repository configuration
# Customize these variables if you want to identify your own generated images.
REPO_NAMESPACE=jamesbrink
REPO_USERNAME=jamesbrink
REPO_NAME=docker-comfyui
# The authors are significant if you plan to publish your image to a public registry.
CONTAINER_AUTHORS="James Brink <brink.james@gmail.com>"

# Container configuration
# These variables control the base image and application versions. If these are changed,
# you may need to update the dependencies in the Dockerfile or entrypoint script.
CUDA_VERSION=13.0.2  # Match this to your GPU driver/runtime support (e.g. change for a different NVIDIA card).
SAGEATTENTION_VERSION=v2.2.0  # Match this to the version of SageAttention you want to use.
OS_VERSION=ubuntu24.04  # Keep aligned with the CUDA base image tag you want to use.

# CUDA GPU architecture list for building CUDA kernels (used by PyTorch extensions)
# Specify the compute capability(s) for your target GPU(s). Common values:
# sm_60 = Pascal (GTX 1xxx, Quadro)
# sm_70 = Volta (V100)
# sm_75 = Turing (RTX 20xx, RTX Super)
# sm_80 = Ampere (RTX 30xx, A100)
# sm_86 = Ampere (RTX 30xx refresh)
# sm_89 = Ada (RTX 40xx except 4090)
# sm_90 = Ada (RTX 4090)
# sm_95 = Blackwell (RTX 5090, 5080, 5070 Ti, etc.)
# You can provide multiple values separated by semicolons, e.g. '8.6;8.9'
TORCH_CUDA_ARCH_LIST=8.9

# Application configuration
# This variable controls the version of ComfyUI and manager to install.
# Updating these should be safe, but major version changes may require additional changes
# to the Dockerfile or entrypoint script to address dependency changes.
COMFYUI_VERSION=v0.34.0
UI_MANAGER_VERSION=main
COMFYUI_CACHE_RAM=16

# Specify whether to enable multi-user mode (login required to access the UI)
MULTI_USER=false

# ComfyUI Kitchen backend configuration
# Controls which comfy-kitchen backends are enabled for optimized operations
# Options: cuda (GPU acceleration), triton, eager (CPU fallback)
# Default: cuda (recommended for GPU systems)
COMFY_KITCHEN_BACKENDS=cuda

# Image name the it is built. COMFYUI_VERSION is added for tagging.
IMAGE_NAME=comfyui
